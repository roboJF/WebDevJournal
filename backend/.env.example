
# development | production
NODE_ENV=development

# Port the API listens on. Most hosts inject PORT automatically.
PORT=5000

# MongoDB connection string (local or Atlas)
# Atlas example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/journal?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/journal

# Long random string (32+ chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Allowed frontend origin(s), comma separated, no trailing slash.
# Dev:  http://localhost:5173
# Prod: https://your-frontend-domain.com
CLIENT_ORIGIN=http://localhost:5173

# --- Optional (sensible defaults shown) -------------------------

# How long a login lasts, in days
# JWT_EXPIRES_DAYS=7

# bcrypt cost factor (10-14 is typical)
# BCRYPT_ROUNDS=12

# Auth cookie name
# COOKIE_NAME=journal_token

# Cookie flags. Defaults: dev -> secure=false, sameSite=lax
#                          prod -> secure=true,  sameSite=none
#   - Frontend and API on different sites (e.g. vercel.app + onrender.com):
#       COOKIE_SECURE=true  COOKIE_SAMESITE=none
#   - Frontend and API on the same parent domain (app.example.com + api.example.com):
#       COOKIE_SECURE=true  COOKIE_SAMESITE=lax  COOKIE_DOMAIN=.example.com
# COOKIE_SECURE=
# COOKIE_SAMESITE=
# COOKIE_DOMAIN=

# Number of reverse proxies in front of the app (Render, Railway, Heroku, nginx...).
# Defaults: dev -> 0, prod -> 1
# TRUST_PROXY=
