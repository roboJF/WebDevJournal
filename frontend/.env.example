# ---------------------------------------------------------------
# Frontend environment variables (Vite)
# Copy to `.env.local` for local work. For production, set these
# in your host's dashboard BEFORE building: Vite bakes them into
# the bundle at build time.
# Only variables prefixed with VITE_ are exposed to the browser,
# so never put secrets here.
# ---------------------------------------------------------------

# Base URL of the backend API (no trailing slash, no /api suffix).
# Dev:  http://localhost:5000
# Prod: https://your-api-domain.com
# If left empty in a production build, requests go to the same origin
# (useful when a reverse proxy serves both app and /api).
VITE_API_URL=http://localhost:5000
